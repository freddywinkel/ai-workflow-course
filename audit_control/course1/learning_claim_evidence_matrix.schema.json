{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course1.invalid/schemas/learning-claim-evidence-matrix-v1.json",
  "title": "Course 1 learning claim and evidence matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseId",
    "contractPath",
    "evidenceRecordSchemaPath",
    "evidenceRecordTemplatePath",
    "releaseEvidenceRoot",
    "requirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "course1-learning-claim-evidence-matrix-v1"
    },
    "courseId": {
      "const": "course-1-controlled-ai-workflow-foundations"
    },
    "contractPath": {
      "const": "COURSE_1_LEARNING_VALIDATION_CONTRACT.md"
    },
    "evidenceRecordSchemaPath": {
      "const": "audit_control/course1/learning_evidence_record.schema.json"
    },
    "evidenceRecordTemplatePath": {
      "const": "release_evidence/templates/COURSE_1_LEARNING_EVIDENCE_RECORD.template.json"
    },
    "releaseEvidenceRoot": {
      "const": "release_evidence/course1_learning_validation"
    },
    "requirements": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "requirementId": {
      "enum": [
        "C1-LV-001",
        "C1-LV-002",
        "C1-LV-003",
        "C1-LV-004",
        "C1-LV-005",
        "C1-LV-006",
        "C1-LV-007",
        "C1-LV-008",
        "C1-LV-009",
        "C1-LV-010",
        "C1-LV-011",
        "C1-LV-012",
        "C1-LV-013",
        "C1-LV-014",
        "C1-LV-015",
        "C1-LV-016",
        "C1-LV-017"
      ]
    },
    "evidenceClass": {
      "enum": [
        "AUTOMATED_ARTIFACT",
        "LEARNER_SELF_REFLECTION",
        "INDEPENDENT_ARTIFACT_ASSESSMENT",
        "INDEPENDENT_ORAL_ASSESSMENT",
        "ROLE_SIMULATED_ACCEPTANCE_REHEARSAL",
        "REAL_SYNTHETIC_UAT",
        "LITERAL_BEGINNER_TRIAL",
        "DELAYED_RETENTION",
        "UNSEEN_TRANSFER",
        "ACCESSIBILITY_REVIEW"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "type",
        "locator",
        "selector",
        "environment",
        "passCondition"
      ],
      "properties": {
        "methodId": {
          "type": "string",
          "pattern": "^C1-LVM-[0-9]{3}$"
        },
        "type": {
          "enum": [
            "automated",
            "manual",
            "hybrid"
          ]
        },
        "locator": {
          "$ref": "#/$defs/nonEmpty"
        },
        "selector": {
          "$ref": "#/$defs/nonEmpty"
        },
        "environment": {
          "$ref": "#/$defs/nonEmpty"
        },
        "passCondition": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "recordLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^release_evidence/course1_learning_validation/[0-9]+\\.[0-9]+\\.[0-9]+/.+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "currentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "records"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNVERIFIED",
            "PASS",
            "FAIL"
          ]
        },
        "records": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recordLocator"
          }
        }
      }
    },
    "learningDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "NOT YET",
            "NOT APPLICABLE"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "owner",
        "observableCapability",
        "claim",
        "evidenceClasses",
        "assessmentMethods",
        "limitation",
        "laterBoundary",
        "currentEvidence",
        "learningDecision"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/requirementId"
        },
        "owner": {
          "$ref": "#/$defs/nonEmpty"
        },
        "observableCapability": {
          "$ref": "#/$defs/nonEmpty"
        },
        "claim": {
          "$ref": "#/$defs/nonEmpty"
        },
        "evidenceClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceClass"
          }
        },
        "assessmentMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "limitation": {
          "$ref": "#/$defs/nonEmpty"
        },
        "laterBoundary": {
          "$ref": "#/$defs/nonEmpty"
        },
        "currentEvidence": {
          "$ref": "#/$defs/currentEvidence"
        },
        "learningDecision": {
          "$ref": "#/$defs/learningDecision"
        }
      }
    }
  }
}
