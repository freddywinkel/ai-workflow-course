{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/course1/technical-evidence-record.schema.json",
  "title": "Course 1 candidate-bound technical evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "testId",
    "candidate",
    "result",
    "evidenceClass",
    "recordedAt",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "course1-technical-evidence-v1"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^C1-EV-[A-Z0-9-]+-[0-9]{3}$"
    },
    "testId": {
      "enum": [
        "C1-TST-DATA-001",
        "C1-TST-FS-001",
        "C1-TST-FS-002",
        "C1-TST-FS-003",
        "C1-TST-FS-004",
        "C1-TST-FS-005",
        "C1-TST-FS-006",
        "C1-TST-FS-007",
        "C1-TST-FS-008",
        "C1-TST-FS-009",
        "C1-TST-FS-010",
        "C1-TST-FS-011",
        "C1-TST-IO-001",
        "C1-TST-IO-002",
        "C1-TST-CAP-001",
        "C1-TST-CAP-002",
        "C1-TST-CAP-003",
        "C1-TST-CAP-005",
        "C1-TST-PWA-NET-001",
        "C1-TST-PWA-STORAGE-001",
        "C1-TST-PWA-BACKUP-001",
        "C1-TST-WEB-001",
        "C1-TST-WEB-002",
        "C1-TST-WEB-003",
        "C1-TST-SW-001",
        "C1-TST-SW-002",
        "C1-TST-SC-001",
        "C1-TST-PROV-001",
        "C1-TST-ORACLE-001",
        "C1-TST-QUALITY-001",
        "C1-TST-WIN-E2E-001",
        "C1-TST-BROWSER-MATRIX-001",
        "C1-TST-RECOVERY-001"
      ]
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "evidenceClass": {
      "enum": [
        "AUTOMATED_LOCAL",
        "NATIVE_WINDOWS",
        "REAL_BROWSER",
        "CI_SUPPLY_CHAIN",
        "POST_DEPLOY",
        "INDEPENDENT_REVIEW"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "independentOfImplementation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "independentOfImplementation": {
          "type": "boolean"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "kind",
        "procedureLocator",
        "procedureSelector",
        "environment"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^release_evidence/(?!templates(?:/|$))(?!\\.\\.?/)(?!.*//)(?!.*(?:/\\.\\.?)(?:/|$))[A-Za-z0-9._/-]+\\.[A-Za-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "COMMAND_LOG",
            "RAW_RESULT",
            "SCREENSHOT",
            "BROWSER_TRACE",
            "REVIEW_RECORD",
            "ENVIRONMENT_ATTESTATION"
          ]
        },
        "procedureLocator": {
          "type": "string",
          "minLength": 1
        },
        "procedureSelector": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "courseVersion",
        "buildId",
        "contentHash"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "courseVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "buildId": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
