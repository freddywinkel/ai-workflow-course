{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/course1/technical-requirement-graph.schema.json",
  "title": "Course 1 technical requirement graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseId",
    "contractPath",
    "requirements",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "course1-technical-requirement-graph-v1"
    },
    "courseId": {
      "const": "course-1-controlled-ai-workflow-foundations"
    },
    "contractPath": {
      "const": "COURSE_1_TECHNICAL_ACCEPTANCE_CONTRACT.md"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C1-TA-(DATA|FS|IO|CAP|PWA|WEB|SW|SC|TEST|WIN|BR|REC)-[0-9]{3}$"
          },
          "family": {
            "enum": [
              "DATA",
              "FS",
              "IO",
              "CAP",
              "PWA",
              "WEB",
              "SW",
              "SC",
              "TEST",
              "WIN",
              "BR",
              "REC"
            ]
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C1-TST-(?:[A-Z0-9]+-)+[0-9]{3}$"
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C1-TST-(?:[A-Z0-9]+-)+[0-9]{3}$"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C1-TA-(DATA|FS|IO|CAP|PWA|WEB|SW|SC|TEST|WIN|BR|REC)-[0-9]{3}$"
            }
          }
        }
      }
    }
  }
}
