{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/course1/technical-test-manifest.schema.json",
  "title": "Course 1 technical test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseId",
    "graphPath",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "course1-technical-test-manifest-v1"
    },
    "courseId": {
      "const": "course-1-controlled-ai-workflow-foundations"
    },
    "graphPath": {
      "const": "audit_control/course1/technical_requirement_graph.json"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "owner",
          "environments",
          "evidenceClass",
          "procedures",
          "currentEvidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C1-TST-(?:[A-Z0-9]+-)+[0-9]{3}$"
          },
          "type": {
            "enum": [
              "executable",
              "manual",
              "hybrid"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "environments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceClass": {
            "enum": [
              "AUTOMATED_LOCAL",
              "NATIVE_WINDOWS",
              "REAL_BROWSER",
              "CI_SUPPLY_CHAIN",
              "POST_DEPLOY",
              "INDEPENDENT_REVIEW"
            ]
          },
          "procedures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locator",
                "selector",
                "command",
                "expected"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "currentEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "records"
            ],
            "properties": {
              "status": {
                "enum": [
                  "UNVERIFIED",
                  "PASS",
                  "FAIL"
                ]
              },
              "records": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/evidenceLocator"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "UNVERIFIED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "records": {
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "records": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^release_evidence/(?!templates/)[A-Za-z0-9._/-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
