{
  "schemaVersion": 2,
  "program": {
    "id": "controlled-ai-workflow-consultant-path",
    "title": "Controlled AI Workflow Implementation Consultant",
    "targetMarket": "Dutch SMEs",
    "positioning": "Help an SME find one worthwhile operational problem, improve the process, implement a controlled AI-assisted workflow in the systems it already uses, train the people involved, and prove the result.",
    "durableValue": "The durable skill is controlled implementation: process discovery, data quality, deterministic rules, evidence, human approval, testing, adoption, measurement, and handover. A particular AI model or workflow canvas is only a replaceable tool."
  },
  "course": {
    "id": "course-1-controlled-ai-workflow-foundations",
    "sequence": 1,
    "title": "Controlled AI Workflow Foundations",
    "shortTitle": "Course 1",
    "subtitle": "From zero technical knowledge to one safe, evidence-backed SME workflow",
    "version": "2.0.0",
    "verifiedThrough": "2026-07-26",
    "learnerStartingPoint": "No coding, automation, consulting, or AI implementation knowledge is assumed.",
    "outcome": "You can investigate a small operational workflow, decide what should and should not be automated, and build a bounded prototype with deterministic checks, evidence, human approval, testing, and a manual fallback.",
    "estimatedHours": {
      "minimum": 110,
      "typical": 130,
      "maximum": 150
    },
    "coreGroupIds": [
      "foundations",
      "modules"
    ],
    "capstone": {
      "title": "Synthetic SME Operations Exception Assistant",
      "summary": "A local-first demonstration that reads a fictional CSV export, detects operational exceptions with deterministic rules, uses AI only for bounded issue-linked explanation, and produces a review package for a human decision.",
      "nonGoals": [
        "It is not a production SaaS product.",
        "It does not take autonomous external action.",
        "It does not use real employer, patient, client, or commercially confidential data.",
        "It is not a Veeva, eQMS, accounting, CRM, or ERP replacement."
      ]
    }
  },
