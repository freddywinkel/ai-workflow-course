{
  "schemaVersion": 2,
  "program": {
    "id": "controlled-ai-workflow-consultant-path",
    "title": "Controlled Artificial Intelligence (AI) Workflow Implementation Consultant",
    "targetMarket": "Dutch small and medium-sized enterprises (SMEs)",
    "positioning": "Help a small and medium-sized enterprise (SME) find one worthwhile operational problem, improve the process, implement a controlled artificial intelligence (AI)-assisted workflow in the systems it already uses, train the people involved, and prove the result.",
    "durableValue": "The durable skill is controlled implementation: understand the process, check data quality, apply fixed rules that give the same result for the same input, link evidence, keep human approval, test failures, help people adopt the change, measure results, and hand over clear instructions. A particular AI model or workflow screen is only a replaceable tool."
  },
  "course": {
    "id": "course-1-controlled-ai-workflow-foundations",
    "sequence": 1,
    "title": "Controlled Artificial Intelligence (AI) Workflow Foundations",
    "shortTitle": "Course 1",
    "subtitle": "From zero technical knowledge to one safe, evidence-backed small and medium-sized enterprise (SME) workflow",
    "version": "2.5.0",
    "practiceRevision": 4,
    "verifiedThrough": "2026-07-28",
    "learnerStartingPoint": "No coding, automation, consulting, or AI implementation knowledge is assumed.",
    "outcome": "You can investigate a small operational workflow, decide what should and should not be automated, and build a small prototype with clear limits, fixed checks, evidence, human approval, testing, and a documented manual way of working.",
    "estimatedHours": {
      "minimum": 137,
      "typical": 160,
      "maximum": 181
    },
    "coreGroupIds": [
      "foundations",
      "modules"
    ],
    "learningSequenceIds": [
      "course-1-readiness-check",
      "course-1-foundation-01",
      "course-1-foundation-02",
      "course-1-beginner-software-check",
      "course-1-windows-setup",
      "course-1-foundation-03",
      "course-1-foundation-04",
      "course-1-foundation-05",
      "course-1-foundation-06",
      "course-1-foundation-07",
