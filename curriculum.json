  "career": {
    "title": "Career sequence",
    "summary": "This PWA teaches Course 1 in full. The remaining courses are separate future builds so technical foundations, consulting practice, governance, and commercial development are not confused with one another.",
    "targetRole": "Controlled AI Workflow Implementation Consultant for Dutch SMEs",
    "courses": [
      {
        "id": "course-1-controlled-ai-workflow-foundations",
        "sequence": 1,
        "title": "Controlled AI Workflow Foundations",
        "status": "current",
        "purpose": "Build technical and control literacy from zero, then complete one synthetic end-to-end implementation.",
        "exitEvidence": "A tested Synthetic SME Operations Exception Assistant, evaluation evidence, a runbook, and a plain-language case study."
      },
      {
        "id": "course-2-workflow-discovery-paid-diagnostics",
        "sequence": 2,
        "title": "SME Workflow Discovery and Paid Diagnostics",
        "status": "proposed",
        "purpose": "Learn ethical outreach, process interviews, observation, baseline economics, data readiness, native-tool checks, opportunity scoring, diagnostic reporting, and pilot charters.",
        "exitEvidence": "A complete fictional diagnostic, interview script, fixed-scope report, and pilot recommendation with success and stop criteria."
      },
      {
        "id": "course-3-sme-integrations-low-code-delivery",
        "sequence": 3,
        "title": "SME Integrations and Low-Code Pilot Delivery",
        "status": "proposed",
        "purpose": "Learn APIs, webhooks, OAuth, connectors, least privilege, environments, retries, rollback, client-owned tenants, UAT, and one bounded low-risk pilot.",
        "exitEvidence": "A reproducible integration lab plus a supervised low-risk pilot or realistic sandbox equivalent."
      },
      {
        "id": "course-4-controlled-document-ai-systems",
        "sequence": 4,
        "title": "Controlled Document AI Systems",
        "status": "proposed",
        "purpose": "Build source-preserving document workflows with PDF/DOCX parsing, OCR, evidence locators, extraction, policy retrieval, grounded drafting, exact-output approval, and evaluation.",
        "exitEvidence": "A controlled synthetic supplier-document review system with parser, extraction, evidence, and reviewer tests."
      },
      {
        "id": "course-5-production-governance-security-reliability",
        "sequence": 5,
        "title": "Production Governance, Security, and Reliability",
        "status": "proposed",
        "purpose": "Learn AVG and AI Act implementation records, vendor review, threat modelling, identity, tenancy, observability, incident response, backup, restore, deletion, and production acceptance.",
        "exitEvidence": "A governed production-readiness dossier plus incident and recovery exercises for a low-risk fictional workflow."
      },
      {
        "id": "course-6-adoption-consulting-managed-assurance",
        "sequence": 6,
        "title": "Adoption, Consulting Delivery, and Managed Assurance",
        "status": "proposed",
        "purpose": "Learn engagement qualification, proposals and boundaries, change control, role-specific AI literacy, adoption, benefits, support, recurring assurance, and solo-practice delivery.",
        "exitEvidence": "An end-to-end fictional engagement pack, adoption plan, benefit review, and managed-assurance operating procedure."
      }
    ],
    "optionalSpecializations": [
      {
        "id": "specialization-quality-document-operations",
        "title": "Quality and Controlled-Document Operations",
        "status": "optional-after-course-5",
        "purpose": "Specialise later in evidence-heavy quality operations, metadata, document control, training records, change control, and cross-system reconciliation without presenting yourself as a Veeva or regulated-systems expert before you have the required experience."
      }
    ],
    "readinessGates": [
      "Do not sell autonomous decision-making or high-consequence clinical, employment, credit, legal, or safety workflows as a beginner.",
      "Use synthetic or expressly authorised data until privacy, security, confidentiality, and client controls are understood.",
      "Complete Course 1 before presenting implementation as a paid capability.",
      "Complete Course 2 discovery practice before selling a build.",
      "Validate demand with interviews and paid diagnostics before building a reusable product."
    ],
    "suggestedPace": {
      "currentCapacity": "Use 15 planned hours plus up to 5 optional hours per week; health and reintegration commitments take priority.",
      "laterCapacity": "At 8–10 hours per week, keep one major learning or client objective active at a time.",
      "sequenceRule": "Courses are sequential foundations, not badges. Advance when the exit evidence is credible, not merely when every page is marked complete."
    }
  }
}
