      "course-1-module-06",
      "course-1-module-07",
      "course-1-module-08",
      "course-1-module-09"
    ],
    "capstone": {
      "title": "Synthetic SME Operations Exception Assistant",
      "summary": "A local-first demonstration that reads a fictional CSV export, detects operational exceptions with deterministic rules, tests a bounded future AI explanation contract with a deterministic offline mock, and produces a review package for a human decision. Course 1 makes no live AI call.",
      "nonGoals": [
        "It is not a production SaaS product.",
        "It does not take autonomous external action.",
        "It does not use real employer, patient, client, or commercially confidential data.",
        "It is not a Veeva, eQMS, accounting, CRM, or ERP replacement."
      ]
    }
  },
