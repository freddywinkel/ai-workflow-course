  "career": {
    "title": "Career sequence",
    "summary": "This progressive web app (PWA), an installable website that can keep working without an internet connection, teaches Course 1 in full. The Career path keeps Courses 2–6 and the optional later cloud prototype visible as future stages without mixing them into the Course 1 learning sequence or completion result.",
    "targetRole": "Controlled Artificial Intelligence (AI) Workflow Implementation Consultant for Dutch Small and Medium-sized Enterprises (SMEs)",
    "courses": [
      {
        "id": "course-1-controlled-ai-workflow-foundations",
        "sequence": 1,
        "title": "Controlled Artificial Intelligence (AI) Workflow Foundations",
        "status": "current",
        "purpose": "Start with no technical background, learn the basic tools and safety controls, then build one complete workflow using made-up (synthetic) data.",
        "exitEvidence": "A tested Synthetic SME Operations Exception Assistant (a practice system that flags records which break stated rules), test evidence, a step-by-step operating guide (runbook), and a plain-language case study."
      },
      {
        "id": "course-2-workflow-discovery-paid-diagnostics",
        "sequence": 2,
        "title": "Workflow Discovery and Paid Problem Assessments",
        "status": "proposed",
        "purpose": "Learn to contact firms responsibly, interview and observe how work is done, measure current time and cost, check whether existing tools already solve the problem, rank opportunities, write a fixed-scope problem assessment (diagnostic), and propose a small trial plan (pilot charter).",
        "exitEvidence": "A complete fictional problem assessment, interview script, fixed-scope report, and small-trial recommendation with success and stop criteria."
      },
      {
        "id": "course-3-sme-integrations-low-code-delivery",
        "sequence": 3,
        "title": "Connect Small-Business Systems and Deliver a Small Trial",
        "status": "proposed",
        "purpose": "Learn application programming interfaces (APIs), automatic event notices (webhooks), limited-access sign-in using Open Authorization (OAuth), prebuilt system links (connectors), minimum necessary access, separate test and live environments, trying a failed step again (retry), returning to a known safe state (rollback), client-owned software environments, user acceptance testing (UAT), and one small low-risk trial (pilot).",
        "exitEvidence": "A reproducible system-connection practice lab plus a supervised low-risk trial or realistic isolated test environment (sandbox)."
      },
      {
        "id": "course-4-controlled-document-ai-systems",
        "sequence": 4,
        "title": "Controlled Document AI Systems",
        "status": "prototype-capstone-available",
        "prototypeDocumentId": "course-4-capstone-overview",
        "purpose": "Use the optional Controlled Document Intake capstone to build and tear down one private Google Cloud demonstration with synthetic documents. The prototype uses Cloud Run, Document AI, and Gemini through Vertex AI while preserving source links, fixed checks, exact-output human approval, approved-only exports, deletion evidence, and a strict €60 learning boundary. The complete Course 4 curriculum remains a later build.",
        "exitEvidence": "A tested synthetic Controlled Document Intake demonstration, source-linked extraction plus bounded selection and fixed-output evidence, exact-output approval, CSV and JSON exports, observed live-provider evidence, cost records, and a verified teardown. This is advanced prototype evidence, not production readiness."
      },
      {
        "id": "course-5-production-governance-security-reliability",
        "sequence": 5,
        "title": "Controls for Secure and Reliable Live Systems",
        "status": "proposed",
        "purpose": "Learn General Data Protection Regulation (GDPR), called the Algemene verordening gegevensbescherming (AVG) in Dutch, and European Union Artificial Intelligence Act (AI Act) implementation records, vendor review, attack analysis, identity and permission controls, separate client environments, monitoring, incident response, backup, restore, deletion, and live-system acceptance.",
        "exitEvidence": "A documented readiness pack for a low-risk fictional live system, plus failure and recovery exercises."
      },
      {
        "id": "course-6-adoption-consulting-managed-assurance",
        "sequence": 6,
        "title": "Adoption, Consulting Delivery, and Ongoing Checks",
        "status": "proposed",
        "purpose": "Learn to decide whether to accept a client request, write proposals and boundaries, control changes, teach people about AI for their role, help them adopt the change, measure benefits, design support, run recurring checks, and operate a solo consulting practice.",
        "exitEvidence": "A complete fictional client pack, adoption plan, benefit review, and step-by-step procedure for recurring checks."
      }
    ],
    "optionalSpecializations": [
      {
        "id": "specialization-quality-document-operations",
        "title": "Quality and Controlled-Document Operations",
        "status": "optional-after-course-5",
        "purpose": "Specialise later in evidence-heavy quality operations, information that describes documents (metadata), document control, training records, change control, and checking that records match across systems (reconciliation), without presenting yourself as a Veeva quality-document platform or regulated-systems expert before you have the required experience."
      }
    ],
    "readinessGates": [
      "Do not sell systems that make decisions without human approval, or high-consequence clinical, employment, credit, legal, or safety workflows, as a beginner.",
      "Use made-up (synthetic) or expressly authorised data until privacy, security, confidentiality, and client controls are understood.",
      "Complete Course 1 before presenting implementation as a paid capability.",
      "Complete Course 2 discovery practice before selling a build.",
      "Treat the Google Cloud capstone as optional advanced practice. Run its cloud steps only after Course 1 and after you understand the Course 3 application programming interface (API), identity, deployment, rollback, and client-owned-environment skills.",
      "Never upgrade a Google Cloud Free Trial to paid billing or use real client, employer, medical, personal, or confidential data for this capstone without explicit approval.",
      "Validate demand with interviews and paid problem assessments before building a reusable product."
    ],
    "suggestedPace": {
      "currentCapacity": "Use 15 planned hours plus up to 5 optional hours per week; health and return-to-work commitments take priority.",
      "laterCapacity": "At 8–10 hours per week, keep one major learning or client objective active at a time.",
      "sequenceRule": "Courses build on one another; they are not badges. Advance when the required proof is credible, not merely when every page is marked complete."
    }
  }
