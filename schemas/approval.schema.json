{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/approval.schema.json",
  "title": "Synthetic Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "run_id",
    "reviewer_role",
    "decision",
    "draft_revision",
    "draft_sha256",
    "decided_at",
    "reason"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": ["approve", "edit", "reject", "expire"]
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 1
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    }
  }
}
