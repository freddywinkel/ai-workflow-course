{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/approval.schema.json",
  "title": "Synthetic Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "run_id",
    "reviewer_role",
    "decision",
    "draft_revision",
    "draft_sha256",
    "review_manifest_sha256",
    "decided_at",
    "expires_at",
    "evidence_reviewed",
    "reason"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[A-F0-9]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-F0-9]{12}$"
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": ["approve", "edit", "reject", "expire"]
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 1
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_reviewed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approve"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "evidence_reviewed": {
            "const": true
          }
        }
      }
    }
  ]
}
