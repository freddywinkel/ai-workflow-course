{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/summary.schema.json",
  "title": "Bounded Source-linked Exception Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "prompt_version",
    "generator",
    "headline",
    "groups",
    "review_actions",
    "unsupported_statements",
    "review_required"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-F0-9]{12}$"
    },
    "prompt_version": {
      "const": "course1-summary-v1"
    },
    "generator": {
      "enum": ["offline-mock", "deterministic-fallback"]
    },
    "headline": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]* verified synthetic issues require human review\\.|Human review is required for [1-9][0-9]* verified synthetic issues\\.)$"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "issue_ids", "summary"],
        "properties": {
          "label": {
            "enum": [
              "High-severity verified issues",
              "Medium-severity verified issues",
              "Low-severity verified issues"
            ]
          },
          "issue_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_type",
          "issue_ids",
          "instruction",
          "external_action"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^ACT-[0-9]{3}$"
          },
          "action_type": {
            "const": "human_review"
          },
          "issue_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "instruction": {
            "type": "string",
            "pattern": "^Review field [a-z_]+ in synthetic source row (?:[2-9]|[1-9][0-9]+); do not perform an external action\\.$"
          },
          "external_action": {
            "const": false
          }
        }
      }
    },
    "unsupported_statements": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_required": {
      "const": true
    }
  }
}
