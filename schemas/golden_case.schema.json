{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-workflow-course/golden_case.schema.json",
  "title": "Synthetic Supplier Gold Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "expected_checkpoint_state",
    "expected",
    "conflicts",
    "findings",
    "evidence_expectations",
    "calculations",
    "memo_contract",
    "approval_contract",
    "deduplication"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^C0(0[1-9]|1[0-9]|20)$"},
    "expected_checkpoint_state": {"$ref": "#/$defs/State"},
    "expected": {"$ref": "#/$defs/Expected"},
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/Conflict"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/Finding"}
    },
    "evidence_expectations": {
      "type": "array",
      "items": {"$ref": "#/$defs/EvidenceExpectation"}
    },
    "calculations": {
      "type": "array",
      "items": {"$ref": "#/$defs/Calculation"}
    },
    "memo_contract": {"$ref": "#/$defs/MemoContract"},
    "approval_contract": {"$ref": "#/$defs/ApprovalContract"},
    "deduplication": {"$ref": "#/$defs/Deduplication"}
  },
  "$defs": {
    "State": {
      "type": "string",
      "enum": [
        "received",
        "validated",
        "parsed",
        "needs_review",
        "pending_approval",
        "approved",
        "rejected",
        "expired",
        "completed",
        "failed_manual"
      ]
    },
    "DecimalOrNull": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "DateOrNull": {
      "type": ["string", "null"],
      "format": "date"
    },
    "LineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "description",
        "quantity",
        "unit",
        "unit_price_ex_vat",
        "line_total_ex_vat"
      ],
      "properties": {
        "sku": {"type": "string"},
        "description": {"type": "string"},
        "quantity": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "unit": {"type": "string"},
        "unit_price_ex_vat": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "line_total_ex_vat": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
      }
    },
    "Expected": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["supplier", "quote", "line_items", "money", "terms"],
      "properties": {
        "supplier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "supplier_code"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "supplier_code": {"type": ["string", "null"]}
          }
        },
        "quote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "date", "valid_until", "currency", "terms_version"],
          "properties": {
            "reference": {"type": ["string", "null"]},
            "date": {"$ref": "#/$defs/DateOrNull"},
            "valid_until": {"$ref": "#/$defs/DateOrNull"},
            "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
            "terms_version": {"type": ["string", "null"]}
          }
        },
        "line_items": {
          "type": "array",
          "items": {"$ref": "#/$defs/LineItem"}
        },
        "money": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subtotal_ex_vat",
            "discount_ex_vat",
            "shipping_ex_vat",
            "net_total_ex_vat",
            "vat_rate_pct",
            "vat_amount",
            "declared_total_inc_vat",
            "calculated_total_inc_vat",
            "discrepancy"
          ],
          "properties": {
            "subtotal_ex_vat": {"$ref": "#/$defs/DecimalOrNull"},
            "discount_ex_vat": {"$ref": "#/$defs/DecimalOrNull"},
            "shipping_ex_vat": {"$ref": "#/$defs/DecimalOrNull"},
            "net_total_ex_vat": {"$ref": "#/$defs/DecimalOrNull"},
            "vat_rate_pct": {"$ref": "#/$defs/DecimalOrNull"},
            "vat_amount": {"$ref": "#/$defs/DecimalOrNull"},
            "declared_total_inc_vat": {"$ref": "#/$defs/DecimalOrNull"},
            "calculated_total_inc_vat": {"$ref": "#/$defs/DecimalOrNull"},
            "discrepancy": {"$ref": "#/$defs/DecimalOrNull"}
          }
        },
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payment_days",
            "prepayment_pct",
            "delivery_calendar_days",
            "warranty_months",
            "governing_law",
            "automatic_renewal"
          ],
          "properties": {
            "payment_days": {"type": ["integer", "null"], "minimum": 0},
            "prepayment_pct": {"$ref": "#/$defs/DecimalOrNull"},
            "delivery_calendar_days": {"type": ["integer", "null"], "minimum": 0},
            "warranty_months": {"type": ["integer", "null"], "minimum": 0},
            "governing_law": {"type": ["string", "null"]},
            "automatic_renewal": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "Conflict": {
      "type": "object",
      "additionalProperties": true,
      "required": ["field_path", "candidates", "canonical_value"],
      "properties": {
        "field_path": {"type": "string"},
        "candidates": {"type": "array", "minItems": 2},
        "canonical_value": {"type": "null"}
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "severity"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "severity": {"type": "string", "enum": ["info", "warning", "error", "critical"]},
        "policy_clause_id": {"type": ["string", "null"]},
        "observed_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expected_routing_state": {
          "anyOf": [
            {"$ref": "#/$defs/State"},
            {"type": "null"}
          ]
        }
      }
    },
    "EvidenceExpectation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "evidence_id",
        "field_path",
        "fixture_document_id",
        "selector_type",
        "expected_excerpt",
        "supporting_text_sha256",
        "evidence_required"
      ],
      "properties": {
        "evidence_id": {"type": "string"},
        "field_path": {"type": "string"},
        "fixture_document_id": {"type": "string"},
        "selector_type": {
          "type": "string",
          "enum": [
            "pdf_bbox",
            "ocr_word_union",
            "docx_logical_path",
            "calculation",
            "completeness"
          ]
        },
        "logical_path": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {
          "type": ["array", "null"],
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 0},
        "expected_excerpt": {"type": "string"},
        "supporting_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_required": {"type": "boolean"}
      }
    },
    "Calculation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["calculation_id", "operation", "rounding", "derived_from_evidence_ids"],
      "properties": {
        "calculation_id": {"type": "string"},
        "operation": {"type": "string"},
        "rounding": {"type": "string"},
        "derived_from_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "MemoContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_propositions", "required_review_statements", "forbidden_propositions"],
      "properties": {
        "required_propositions": {"type": "array", "items": {"type": "object"}},
        "required_review_statements": {"type": "array", "items": {"type": "string"}},
        "forbidden_propositions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ApprovalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvals_required",
        "distinct_reviewer_ids",
        "bind_to_output_hash",
        "expires_after_hours"
      ],
      "properties": {
        "approvals_required": {"type": "integer", "minimum": 1},
        "distinct_reviewer_ids": {"type": "boolean"},
        "bind_to_output_hash": {"const": true},
        "expires_after_hours": {"type": "integer", "minimum": 1}
      }
    },
    "Deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_duplicate", "duplicate_of_case_id", "external_actions_expected"],
      "properties": {
        "expected_duplicate": {"type": "boolean"},
        "duplicate_of_case_id": {
          "type": ["string", "null"],
          "pattern": "^C0(0[1-9]|1[0-9]|20)$"
        },
        "external_actions_expected": {"type": "integer", "minimum": 0, "maximum": 0}
      }
    }
  }
}
