{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/audit_event.schema.json",
  "title": "Course 1 Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "event_type",
    "state",
    "occurred_at",
    "actor_type",
    "details"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[A-F0-9]{16}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-F0-9]{12}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "state": {
      "enum": [
        "received",
        "validated",
        "issues_ready",
        "summary_ready",
        "needs_review",
        "changes_requested",
        "approved_for_local_export",
        "approved_draft",
        "rejected",
        "expired",
        "no_action_needed",
        "failed_manual"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_type": {
      "enum": ["system", "mock_ai", "ai", "reviewer"]
    },
    "details": {
      "type": "object"
    }
  }
}
