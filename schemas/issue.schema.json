{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/issue.schema.json",
  "title": "Verified Deterministic Issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "work_item_id",
    "source_reference",
    "source_row",
    "field",
    "raw_value",
    "rule_code",
    "severity",
    "message",
    "assessment_date"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^WI-[0-9]{4}\\|R[0-9]{3}\\|[a-z_]+$"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^WI-[0-9]{4}$"
    },
    "source_reference": {
      "type": "string"
    },
    "source_row": {
      "type": "integer",
      "minimum": 2
    },
    "field": {
      "enum": [
        "work_item_id",
        "source_reference",
        "title",
        "owner_role",
        "status",
        "priority",
        "received_date",
        "due_date",
        "completed_date",
        "amount",
        "currency",
        "category"
      ]
    },
    "raw_value": {
      "type": "string"
    },
    "rule_code": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "severity": {
      "enum": ["low", "medium", "high"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    }
  }
}
